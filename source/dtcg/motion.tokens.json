{
  "motion": {
    "duration": {
      "instant": {
        "$type": "number",
        "$value": 50
      },
      "fast": {
        "$type": "number",
        "$value": 100
      },
      "normal": {
        "$type": "number",
        "$value": 150
      },
      "slow": {
        "$type": "number",
        "$value": 250
      },
      "slower": {
        "$type": "number",
        "$value": 400
      }
    },
    "easing": {
      "standard": {
        "$type": "string",
        "$value": "cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "enter": {
        "$type": "string",
        "$value": "cubic-bezier(0, 0, 0.2, 1)"
      },
      "exit": {
        "$type": "string",
        "$value": "cubic-bezier(0.4, 0, 1, 1)"
      },
      "spring": {
        "$type": "string",
        "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)"
      }
    }
  }
}
