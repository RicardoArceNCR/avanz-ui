{
  "button": {
    "font-weight": {
      "$type": "number",
      "$value": 600
    },
    "radius": {
      "$type": "number",
      "$value": "{radius.md}"
    },
    "primary": {
      "bg": {
        "$type": "color",
        "$value": "{color.brand.600}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.brand.700}"
      },
      "bg-press": {
        "$type": "color",
        "$value": "{color.brand.800}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.brand.600}"
      }
    },
    "secondary": {
      "bg": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.neutral.50}"
      },
      "bg-press": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.neutral.950}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.neutral.500}"
      }
    },
    "ghost": {
      "bg": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.neutral.50}"
      },
      "bg-press": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.brand.700}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.white}"
      }
    },
    "danger": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.700}"
      },
      "bg-hover": {
        "$type": "color",
        "$value": "{color.danger.800}"
      },
      "bg-press": {
        "$type": "color",
        "$value": "{color.danger.900}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.white}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.danger.700}"
      }
    },
    "disabled": {
      "bg": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.neutral.400}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.neutral.100}"
      }
    },
    "size": {
      "sm": {
        "height": {
          "$type": "number",
          "$value": 32
        },
        "padding-x": {
          "$type": "number",
          "$value": 12
        }
      },
      "md": {
        "height": {
          "$type": "number",
          "$value": 40
        },
        "padding-x": {
          "$type": "number",
          "$value": 16
        }
      },
      "lg": {
        "height": {
          "$type": "number",
          "$value": 48
        },
        "padding-x": {
          "$type": "number",
          "$value": 24
        }
      }
    }
  },
  "input": {
    "bg": {
      "$type": "color",
      "$value": "{color.white}"
    },
    "bg-focus": {
      "$type": "color",
      "$value": "{color.white}"
    },
    "bg-disabled": {
      "$type": "color",
      "$value": "{color.neutral.50}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.neutral.500}"
    },
    "border-hover": {
      "$type": "color",
      "$value": "{color.neutral.700}"
    },
    "border-focus": {
      "$type": "color",
      "$value": "{color.brand.600}"
    },
    "border-error": {
      "$type": "color",
      "$value": "{color.danger.700}"
    },
    "border-success": {
      "$type": "color",
      "$value": "{color.success.700}"
    },
    "border-disabled": {
      "$type": "color",
      "$value": "{color.neutral.200}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.neutral.950}"
    },
    "placeholder": {
      "$type": "color",
      "$value": "{color.neutral.700}"
    },
    "label": {
      "$type": "color",
      "$value": "{color.neutral.800}"
    },
    "text-disabled": {
      "$type": "color",
      "$value": "{color.neutral.400}"
    },
    "radius": {
      "$type": "number",
      "$value": "{radius.md}"
    },
    "padding-x": {
      "$type": "number",
      "$value": 12
    },
    "padding-y": {
      "$type": "number",
      "$value": 10
    }
  },
  "card": {
    "bg": {
      "$type": "color",
      "$value": "{color.white}"
    },
    "border": {
      "$type": "color",
      "$value": "{color.neutral.200}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.neutral.950}"
    },
    "bg-hover": {
      "$type": "color",
      "$value": "{color.neutral.50}"
    },
    "border-hover": {
      "$type": "color",
      "$value": "{color.neutral.300}"
    },
    "radius": {
      "$type": "number",
      "$value": "{radius.lg}"
    },
    "padding": {
      "$type": "number",
      "$value": 24
    },
    "shadow": {
      "$type": "string",
      "$value": "0px 1px 2px rgba(0, 0, 0, 0.06), 0px 1px 3px rgba(0, 0, 0, 0.10)"
    }
  },
  "pill": {
    "radius": {
      "$type": "number",
      "$value": 9999
    },
    "base": {
      "bg": {
        "$type": "color",
        "$value": "{color.neutral.50}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.neutral.800}"
      },
      "border": {
        "$type": "color",
        "$value": "{color.neutral.300}"
      }
    },
    "brand": {
      "bg": {
        "$type": "color",
        "$value": "{color.brand.50}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.brand.800}"
      }
    },
    "success": {
      "bg": {
        "$type": "color",
        "$value": "{color.success.50}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.success.800}"
      }
    },
    "warning": {
      "bg": {
        "$type": "color",
        "$value": "{color.warning.50}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.warning.800}"
      }
    },
    "error": {
      "bg": {
        "$type": "color",
        "$value": "{color.danger.50}"
      },
      "text": {
        "$type": "color",
        "$value": "{color.danger.800}"
      }
    },
    "sm": {
      "padding-x": {
        "$type": "number",
        "$value": 8
      }
    },
    "md": {
      "padding-x": {
        "$type": "number",
        "$value": 12
      }
    }
  }
}
